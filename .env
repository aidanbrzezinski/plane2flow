# ---- Plane (read-only) -------------------------------------------------
# Personal API token: Plane > profile > Settings > API tokens.
PLANE_BASE_URL=https://plane.lokislair.com
PLANE_API_KEY=plane_api_13007b2ad8ef4e8fab3baaf477c8cf7d
PLANE_WORKSPACE=2026-formula-electric
PLANE_PROJECT=EV27
# set to 1 only if the instance still has a self-signed cert
PLANE_INSECURE=0
# Relations cost one request per work item and Plane allows 60 requests/minute,
# so the first pull of a big project is paced (~3 min for 175 items). After that
# the on-disk cache means only changed items are re-read.
PLANE_WORKERS=4
PLANE_RATE=55

# ---- board -------------------------------------------------------------
PF_REFRESH_SECONDS=300
PF_TITLE=EV27 dependency flow
PF_SUBTITLE=LTU Formula Electric
# PF_FALLBACK_CSV=/fallback/export.csv

# Leave empty to disable POST /api/refresh entirely (the default).
PF_REFRESH_TOKEN=
