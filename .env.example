# ---- Plane (read-only) -------------------------------------------------
# Personal API token: Plane > profile > Settings > API tokens.
PLANE_BASE_URL=https://plane.lokislair.com
PLANE_API_KEY=plane_api_replace_me
PLANE_WORKSPACE=2026-formula-electric
PLANE_PROJECT=EV27
# set to 1 only if the instance still has a self-signed cert
PLANE_INSECURE=0
# Relations cost one request per work item and Plane allows 60 requests/minute,
# so the first pull of a big project is paced (~3 min for 175 items). After that
# the on-disk cache means only changed items are re-read.
PLANE_WORKERS=4
PLANE_RATE=55

# ---- board -------------------------------------------------------------
PF_REFRESH_SECONDS=300
PF_TITLE=EV27 dependency flow
PF_SUBTITLE=LTU Formula Electric
# PF_FALLBACK_CSV=/fallback/export.csv

# --- behaviour ----------------------------------------------------------
# block: a parent cannot finish until every child is done. contain | ignore.
PF_PARENT_MODE=block
# The "Done without passing Review" check reads each Done item's history.
# One extra request per Done item, cached. Set 0 to skip it.
PF_CHECK_HISTORY=1

# --- the Refresh button -------------------------------------------------
# Refreshing only re-READS Plane, so it is open by default and throttled
# rather than locked. This is the minimum gap between manual refreshes.
PF_REFRESH_MIN_SECONDS=20
# Set a token to require ?token=... on POST /api/refresh as well.
PF_REFRESH_TOKEN=
